{
  "entities": {
    "Item": {
      "title": "Item",
      "description": "A household inventory item with stock targets and current quantity",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the item"
        },
        "userId": {
          "type": "string",
          "description": "User ID of the inventory owner"
        },
        "itemName": {
          "type": "string",
          "description": "Display name of the item",
          "maxLength": 150
        },
        "category": {
          "type": "string",
          "description": "Category classification of the item",
          "maxLength": 80
        },
        "photo": {
          "type": "string",
          "description": "URL of the item photo",
          "maxLength": 1000
        },
        "targetMonthlyStock": {
          "type": "number",
          "description": "Target monthly stock quantity"
        },
        "currentStock": {
          "type": "number",
          "description": "Current total on-hand stock quantity across all homes"
        },
        "homeId": {
          "type": "string",
          "description": "Primary home identifier (e.g. home-1, home-2, or custom added home ID)",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "homeStocks": {
          "type": "object",
          "description": "Per-home stock map keyed by dynamic home IDs"
        },
        "unit": {
          "type": "string",
          "description": "Unit of measurement or packaging container",
          "maxLength": 50
        },
        "location": {
          "type": "string",
          "description": "Physical storage location in the home",
          "maxLength": 100
        },
        "notes": {
          "type": "string",
          "description": "Optional notes or details",
          "maxLength": 500
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": [
        "itemName",
        "category",
        "targetMonthlyStock",
        "currentStock"
      ]
    },
    "HomeDefinition": {
      "title": "HomeDefinition",
      "description": "Customizable home category (e.g. Home 1 Central, Home 2, or user-added homes)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_-]+$" },
        "name": { "type": "string", "maxLength": 60 },
        "isCentral": { "type": "boolean" }
      },
      "required": ["id", "name"]
    },
    "StockTransfer": {
      "title": "StockTransfer",
      "description": "Record of stock picked/transferred from Central Home to another home",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "itemId": { "type": "string" },
        "itemName": { "type": "string", "maxLength": 150 },
        "fromHomeId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_-]+$" },
        "toHomeId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_-]+$" },
        "quantity": { "type": "number" },
        "unit": { "type": "string", "maxLength": 50 },
        "transferredAt": { "type": "string" },
        "transferredBy": { "type": "string", "maxLength": 150 }
      },
      "required": ["id", "itemId", "itemName", "fromHomeId", "toHomeId", "quantity", "transferredAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Basic user profile data",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth user identifier"
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 150
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "description": "User profile photo URL",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "description": "Account registration timestamp"
        }
      },
      "required": [
        "uid"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document restricted to the authenticated user"
    },
    "/users/{userId}/items/{itemId}": {
      "schema": "Item",
      "description": "Legacy individual household inventory items belonging to the user"
    },
    "/households/{householdId}/items/{itemId}": {
      "schema": "Item",
      "description": "Shared household inventory items across Home 1 (Central), Home 2, and Home 3"
    },
    "/households/{householdId}/transfers/{transferId}": {
      "schema": "StockTransfer",
      "description": "Stock pick/transfer logs from Home 1 Central to Home 2 and Home 3"
    }
  }
}
